# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# The content pack is generated by tools/build_pack.py from Korean Student
# Simulator's own data. It is for local use only and is not redistributable,
# so it stays out of the repo -- regenerate it instead.
/packs/

# Placeholder art copied from KSS by tools/copy_assets.py. Same reason.
/assets/images/

# Account-menu catalog generated by tools/build_account_catalog.py. Same reason.
/assets/account/

# Local reference captures supplied for reverse engineering.
/references/screenshots/
/references/recovery/

# The knowledge graph is derived from the sources in this repo (see CLAUDE.md
# §5c). ~1.8 MB of graph, HTML and extraction caches that regenerate from
# `/graphify` -- keep it out and rebuild instead.
/graphify-out/

# Original-game main-menu captures: local reference art, like references/screenshots.
/screenshots/main-menu-2026-10-24/*.jpg

# User-supplied D-Day recording and derived reference art stay local.
/screenshots/dday-applications-2026-10-25/*.mp4
/screenshots/dday-applications-2026-10-25/*.jpg
/screenshots/dday-applications-2026-10-25/*.zip
/screenshots/dday-applications-2026-10-25/key-frames/
/screenshots/dday-applications-2026-10-25/review/
# Later original-game captures: keep the media local, commit manifests/docs.
/screenshots/original-game-followup-2026-10-24/**/*.jpg
/screenshots/original-game-followup-2026-10-24/**/*.png
/screenshots/original-game-followup-2026-10-24/**/*.mp4
/screenshots/dday-applications-2026-10-25/**/*.jpg
/screenshots/dday-applications-2026-10-25/**/*.png
/screenshots/dday-applications-2026-10-25/**/*.mp4

# Agent notes, briefs and task lists stay local.
/CLAUDE.md
/AGENTS.md
/RE-BRIEF.md
/*BRIEF*.md
/TODO.md
/TODO-DONE.md

# Original-game reference material: local only, never published.
# Screenshot captures and their specs, original-game research and the
# native function index (2026-10-26).
/screenshots/
/docs/ui-reference/
/docs/UI-REFERENCE.md
/docs/MAIN-MENU-REFERENCE.md
/docs/ORIGINAL-GAME-*.md
/docs/original-game-*.json
/docs/D-DAY-COMPARISON-*.md
/docs/D-DAY-APPLICATIONS-REFERENCE-*.md
