**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# The content pack is generated by tools/build_pack.py from Korean Student
# Simulator's own data. It is for local use only and is not redistributable,
# so it stays out of the repo -- regenerate it instead.
/packs/

# Placeholder art copied from KSS by tools/copy_assets.py. Same reason.
/assets/images/

# Account-menu catalog generated by tools/build_account_catalog.py. Same reason.
/assets/account/

# Local reference captures supplied for reverse engineering.
/references/screenshots/
/references/recovery/

# The knowledge graph is derived from the sources in this repo (see CLAUDE.md
# §5c). ~1.8 MB of graph, HTML and extraction caches that regenerate from
# `/graphify` -- keep it out and rebuild instead.
/graphify-out/

# Original-game main-menu captures: local reference art, like references/screenshots.
/screenshots/main-menu-2026-10-24/*.jpg
