{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "d30mode/events.schema.json",
  "title": "d30mode events/events.json (also events_female.json, system.json)",
  "description": "See docs/pack-studio/04-EVENT-AUTHORING.md. Structural only: reference checks (node links, IDs) are in 06-VALIDATION.md. Unknown keys are allowed and preserved.",
  "type": "object",
  "properties": {
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
      }
    },
    "bindings": {
      "type": "object",
      "description": "system.json only.",
      "properties": {
        "exhaustion": { "type": "integer" },
        "exerciseLevelUp": { "type": "integer" },
        "partTimeLevelUp": { "type": "integer" }
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["id", "rootNodeId"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "rootNodeId": { "type": "integer" },
        "conditionSet": { "$ref": "common.schema.json#/$defs/conditionSet" },
        "isRandomDate": { "type": "boolean" },
        "priority": { "type": "string", "description": "Default order veryHigh, high, middle, low (rules.events.priorityOrder)." },
        "rank": { "type": "string" },
        "section": { "enum": ["none", "one", "two", "three", "four", "five", "six"] },
        "eventSetId": { "type": ["integer", "null"] },
        "isFake": { "type": "boolean" },
        "characterIdList": { "type": ["array", "null"], "items": { "type": "integer" } }
      }
    },
    "option": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "nextNodeId": { "type": ["integer", "null"] },
        "conditionSet": { "$ref": "common.schema.json#/$defs/conditionSet" }
      }
    },
    "node": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "integer", "description": "Unique pack-wide; convention eventId*1000+n." },
        "boxId": { "type": ["integer", "null"] },
        "type": { "type": "string", "description": "text, option, ifElse, last; others are presentation and pass through." },
        "text": { "type": ["string", "null"] },
        "elseText": { "type": ["string", "null"] },
        "optionText": { "type": ["string", "null"] },
        "nextNodeId": { "type": ["integer", "null"] },
        "nextNodeIdIfTrue": { "type": ["integer", "null"] },
        "nextNodeIdIfFalse": { "type": ["integer", "null"] },
        "options": { "type": ["array", "null"], "items": { "$ref": "#/$defs/option" } },
        "conditionSet": { "$ref": "common.schema.json#/$defs/conditionSet" },
        "changer": { "$ref": "common.schema.json#/$defs/changer" },
        "speakerId": { "type": ["integer", "null"] },
        "isHideSpeakerName": { "type": ["boolean", "null"] },
        "standingId": { "type": ["integer", "null"] },
        "standingOff": { "type": ["boolean", "null"] },
        "standingExpression": { "type": ["string", "null"] },
        "standingClothes": { "type": ["string", "null"] },
        "otherLayerList": { "type": ["array", "null"], "items": { "type": "string" } },
        "backgroundImg": { "type": ["string", "null"], "description": "Key into presentation.backgrounds." },
        "continueTargetSwitch": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "option" } }, "required": ["type"] },
          "then": { "required": ["options"] }
        }
      ]
    }
  }
}
